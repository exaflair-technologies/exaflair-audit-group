# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# SMTP account used to email "Book a call" requests (Google Workspace, Zoho, SES, Postmark…).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bookings@exaflair.com
SMTP_PASS=your-app-password
# Optional: sender shown on the email (defaults to SMTP_USER) and where requests go (defaults to admin@exaflair.com).
# MAIL_FROM="Exaflair Audits <bookings@exaflair.com>"
# BOOKING_TO=admin@exaflair.com
