# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# SMTP account used to email "Book a call" requests (Google Workspace, Zoho, SES, Postmark…).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@exaflair.com
SMTP_PASS=your-app-password
# Sender shown on the email (defaults to SMTP_USER) and where requests go (defaults to admin@exaflair.com).
MAIL_FROM="Exaflair Audits <admin@exaflair.com>"
BOOKING_TO=admin@exaflair.com

# Report PDF links on /portfolio/<slug>, one per audit: REPORT_URL_<SLUG in caps, dashes → underscores>.
# Leave one unset and that audit shows "Full report available on request". Changing these needs a rebuild.
REPORT_URL_WORKCHAIN_JULY_2026=https://drive.google.com/file/d/15HhmYbmfD01FbuWiKlXfGpTMuqUciVt3/view?usp=sharing
REPORT_URL_RECURXPAY_SEPTEMBER_2025=https://drive.google.com/file/d/1QfOSYcq9XjeUTM-IqxH-B31vFEYWEeck/view?usp=sharing
REPORT_URL_LOH_QUEST_DECEMBER_2025=https://drive.google.com/file/d/1OSwzc8T1YUNOgtID3W3e25UoFG18blHH/view?usp=sharing
REPORT_URL_GOMARKET_OCTOBER_2026=https://drive.google.com/file/d/1KRoYAuwf_bKf4UMMRNRx0IzXAcSZez57/view?usp=sharing
